{
  //+---------------------------
  //         Appearance
  //+---------------------------
  "workbench.colorTheme": "Catppuccin Frappé",
  "editor.fontFamily": "'RobotoMono Nerd Font', 'Droid Sans Mono', 'monospace', monospace, 'Droid Sans Fallback'",
  "editor.lineNumbers": "relative",
  "editor.renderWhitespace": "all",
  "editor.minimap.enabled": false,
  //+---------------------------
  //           Editor
  //+---------------------------
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "diffEditor.ignoreTrimWhitespace": false,
  //+---------------------------
  //     Privacy & Security
  //+---------------------------
  "telemetry.telemetryLevel": "off",
  "security.workspace.trust.untrustedFiles": "open",
  //+---------------------------
  //            Vim
  //+---------------------------
  "vim.ignorecase": true,
  "vim.smartcase": false,
  "vim.hlsearch": true,
  "vim.useSystemClipboard": true,
  //+---------------------------
  //           C / C++
  //+---------------------------
  // Disable Microsoft C/C++ IntelliSense, clangd is used instead
  "C_Cpp.errorSquiggles": "Disabled",
  "C_Cpp.intelliSenseEngineFallback": "Disabled",
  "C_Cpp.intelliSenseEngine": "Disabled",
  "C_Cpp.autocomplete": "Disabled",
  // "clangd.fallbackFlags": ["-std=c++17"],
  "clangd.arguments": [
    "--log=verbose",
    "--pretty",
    "--all-scopes-completion",
    "--completion-style=bundled",
    "--header-insertion=iwyu",
    "--header-insertion-decorators",
    "--background-index",
    "--clang-tidy",
    "-j=4"
  ],
  "[c][cpp]": {
    "editor.wordBasedSuggestions": "off",
    "editor.suggest.insertMode": "replace",
    "editor.semanticHighlighting.enabled": true,
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.rulers": [
      100,
      { "column": 120, "color": "#ff9900" }
    ]
  },
  //+---------------------------
  //           Python
  //+---------------------------
  // basedpyright provides the language server, Pylance only runs in Microsoft's VS Code
  "python.languageServer": "None",
  "basedpyright.analysis.typeCheckingMode": "strict",
  "[python]": {
    "editor.tabSize": 4,
    "editor.rulers": [
      100,
      { "column": 120, "color": "#9f0af5" }
    ]
  },
  //+---------------------------
  //           LaTeX
  //+---------------------------
  "[latex]": {
    "editor.formatOnSave": true
  },
  "latex-workshop.formatting.latex": "tex-fmt",
  "latex-workshop.latex.external.build.args": [
    "-shell-escape"
  ],
  "latex-workshop.latex.magic.args": [
    "-synctex=1",
    "-interaction=nonstopmode",
    "-file-line-error",
    "-shell-escape",
    "%DOC%"
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": ["latexmk"]
    },
    {
      "name": "pdflatex ➞ makeglossaries ➞ biber ➞ pdflatex",
      "tools": ["pdflatex", "makeglossaries", "biber", "pdflatex"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-shell-escape",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "makeglossaries",
      "command": "makeglossaries",
      "args": ["%DOCFILE%"]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": ["%DOC%"]
    }
  ],
  //+---------------------------
  //            Web
  //+---------------------------
  "emmet.triggerExpansionOnTab": true,
  "emmet.useInlineCompletions": true,
  "liveServer.settings.donotShowInfoMsg": true,
  //+---------------------------
  //        Claude Code
  //+---------------------------
  "claudeCode.hideOnboarding": true
}
